# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)

# Vite puts a content hash in every file name under /assets: a changed file
# gets a new name, so these can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page that points at those files must always be checked again, or a
# visitor keeps an old build after a deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
