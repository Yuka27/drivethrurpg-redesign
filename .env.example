# Copy to .env and fill in. Validated at startup by src/lib/env.ts.

# Mock API host, without /api/v1 (required)
VITE_API_URL=https://drivethrurpg-mock-api.onrender.com

# Optional: "guest" makes the mock API answer as logged out
# VITE_MOCK_USER=guest

# Portfolio notice links (src/config/project-links.ts).
# Unset: the default (GitHub: this repository, API docs: VITE_API_URL + /docs).
# Empty (e.g. VITE_COVERAGE_URL=): that card is left out. Figma and coverage
# have no default, so their cards show only once set.
# VITE_FIGMA_URL=https://www.figma.com/design/your-file-key/DriveThruRPG-redesign
# VITE_GITHUB_URL=https://github.com/Yuka27/drivethrurpg-redesign
# VITE_API_DOCS_URL=https://drivethrurpg-mock-api.onrender.com/docs
# VITE_COVERAGE_URL=https://your-site.example/coverage/

# "false": no portfolio notice on the first visit (screenshots, e2e runs).
# The footer's "About this project" still opens it.
# VITE_SHOW_PORTFOLIO_NOTICE=false
